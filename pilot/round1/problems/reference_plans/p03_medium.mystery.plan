(sogef pagut lepu menes zonod silud)
(sogef pagut menes veru silud dirade)
(sogef ditit lepu nilag zonod silud)
(sogef pagut veru nilag dirade rada)
(sebo pagut nilag rada zonod)
(sogef pagut nilag gigo zonod silud)
(vumomos pagut gigo)
(sogef pagut gigo zaniva silud dirade)
(vumomos pagut zaniva)
(sogef pagut zaniva gigo dirade rada)
(sogef pagut gigo nilag rada beded)
(sebo pagut nilag beded zonod)
(sogef pagut nilag veru zonod silud)
(kibel pagut zaniva veru)
(kibel pagut gigo veru)
(zozum ditit nilag silud dirade)
(sebo ditit nilag dirade zonod)
(sogef ditit nilag tefer zonod silud)
(sogef ditit tefer dono silud dirade)
(rifuraz ditit nilag dono)
(zozum ditit dono dirade rada)
(rifuraz ditit dono dono)
