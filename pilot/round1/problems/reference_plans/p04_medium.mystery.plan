(sogef ditit lepu zaniva zonod silud)
(vumomos ditit zaniva)
(sogef ditit zaniva lepu silud dirade)
(sogef ditit lepu nilag dirade rada)
(sogef ditit nilag tefer rada beded)
(sebo ditit tefer beded zonod)
(vumomos ditit tefer)
(sogef ditit tefer nilag zonod silud)
(sogef ditit nilag gigo silud dirade)
(sogef ditit gigo dono dirade rada)
(kibel ditit zaniva dono)
(kibel ditit tefer dono)
(sogef pagut lepu nilag zonod silud)
(sogef pagut nilag veru silud dirade)
(zozum pagut veru dirade rada)
(sogef pagut veru menes rada beded)
(sebo pagut menes beded zonod)
(sogef pagut menes dono zonod silud)
(rifuraz pagut veru dono)
(sogef pagut dono menes silud dirade)
(zozum pagut menes dirade rada)
(sogef pagut menes dono rada beded)
(rifuraz pagut menes dono)
